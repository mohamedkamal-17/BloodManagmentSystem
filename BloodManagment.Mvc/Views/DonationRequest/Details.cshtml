@using BloodManagment.Mvc.ViewModels.DonationRequest
@model DonationRequestDetailsViewModel

@{
    ViewData["Title"] = "تفاصيل طلب التبرع";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<style>
    /* 🌍 Page spacing */
    h3 {
        font-weight: 700;
        color: #333;
    }

    /* 🪟 Cards */
    .card {
        border: none;
        border-radius: 18px;
        background: linear-gradient(145deg, #ffffff, #f7f5f2);
        box-shadow: 0 12px 30px rgba(0,0,0,0.08);
        transition: 0.25s ease;
    }

        .card:hover {
            transform: translateY(-4px);
            box-shadow: 0 18px 40px rgba(0,0,0,0.12);
        }

    .card-body {
        padding: 22px;
    }

    /* 🧾 Section titles */
    .card h5 {
        font-weight: 700;
        color: #444;
        border-bottom: 2px solid #eee;
        padding-bottom: 8px;
        margin-bottom: 15px;
    }

    /* 📌 Info rows */
    .card .mb-2 {
        background: #fafafa;
        padding: 10px 14px;
        border-radius: 10px;
        margin-bottom: 10px;
        font-size: 14px;
        display: flex;
        justify-content: space-between;
        transition: 0.2s;
    }

        .card .mb-2:hover {
            background: #f1f1f1;
        }

    .card strong {
        color: #666;
    }

    /* 📋 Health list */
    .list-group-item {
        border: none;
        border-radius: 12px;
        margin-bottom: 6px;
        background: #fafafa;
        font-size: 14px;
        padding: 10px 14px;
        transition: 0.2s;
    }

        .list-group-item:hover {
            background: #f3f0ea;
            transform: scale(1.01);
        }

    /* 🏷 Badges */
    .badge {
        padding: 6px 10px;
        font-size: 12px;
        border-radius: 12px;
        font-weight: 600;
    }

    .bg-success {
        background: linear-gradient(135deg, #28a745, #4caf50) !important;
    }

    .bg-danger {
        background: linear-gradient(135deg, #e53935, #c62828) !important;
    }

    /* 🔘 Back button */
    .btn-secondary {
        border-radius: 12px;
        padding: 8px 20px;
        transition: 0.2s;
    }

        .btn-secondary:hover {
            transform: scale(1.05);
            background: #555;
        }

    /* 📱 Responsive polish */
   

    
</style>

<h3 class="mb-4 text-end">تفاصيل طلب التبرع</h3>

<div class="row">

    <!-- Request Info -->

    <div class="col-md-6">

        <div class="card shadow-sm">
            <div class="card-body text-end">

                <h5 class="mb-3">معلومات الطلب</h5>

                <div class="mb-2">
                    <strong>كود الطلب:</strong>
                    @Model.RequestCode
                </div>

                <div class="mb-2">
                    <strong>اسم المتبرع:</strong>
                    @Model.DonarName
                </div>

                <div class="mb-2">
                    <strong>تاريخ الطلب:</strong>
                    @Model.RequestDate.ToString("yyyy/MM/dd")
                </div>

                <div class="mb-2">
                    <strong>موعد التبرع:</strong>
                    @Model.PreferredDonationDate.ToString("yyyy/MM/dd")
                </div>

                <div class="mb-2">
                    <strong>الحالة:</strong>
                    @Model.Statu
                </div>

            </div>
        </div>
         
    </div>


    <!-- Health Condition -->

    <div class="col-md-6">

        <div class="card shadow-sm">
            <div class="card-body text-end">

                <h5 class="mb-3">الحالة الصحية</h5>
                <ul class="list-group">

                    <li class="list-group-item d-flex justify-content-between">
                        فقر الدم
                        <span class="badge @(Model.HealthCondition.HasAnemia ? "bg-danger" : "bg-success")">
                            @(Model.HealthCondition.HasAnemia ? "✔ Yes" : "✖ No")
                        </span>
                    </li>

                    <li class="list-group-item d-flex justify-content-between">
                        الصفراء
                        <span class="badge @(Model.HealthCondition.HasJaundice ? "bg-danger" : "bg-success")">
                            @(Model.HealthCondition.HasJaundice ? "✔ Yes" : "✖ No")
                        </span>
                    </li>

                    <li class="list-group-item d-flex justify-content-between">
                        أمراض القلب
                        <span class="badge @(Model.HealthCondition.HasHeartDisease ? "bg-danger" : "bg-success")">
                            @(Model.HealthCondition.HasHeartDisease ? "✔ Yes" : "✖ No")
                        </span>
                    </li>

                    <li class="list-group-item d-flex justify-content-between">
                        السرطان
                        <span class="badge @(Model.HealthCondition.HasCancer ? "bg-danger" : "bg-success")">
                            @(Model.HealthCondition.HasCancer ? "✔ Yes" : "✖ No")
                        </span>
                    </li>

                    <li class="list-group-item d-flex justify-content-between">
                        السكري
                        <span class="badge @(Model.HealthCondition.HasDiabetes ? "bg-danger" : "bg-success")">
                            @(Model.HealthCondition.HasDiabetes ? "✔ Yes" : "✖ No")
                        </span>
                    </li>

                    <li class="list-group-item d-flex justify-content-between">
                        الإيدز
                        <span class="badge @(Model.HealthCondition.HasAIDS ? "bg-danger" : "bg-success")">
                            @(Model.HealthCondition.HasAIDS ? "✔ Yes" : "✖ No")
                        </span>
                    </li>

                    <li class="list-group-item d-flex justify-content-between">
                        نزلات البرد
                        <span class="badge @(Model.HealthCondition.HasCold ? "bg-danger" : "bg-success")">
                            @(Model.HealthCondition.HasCold ? "✔ Yes" : "✖ No")
                        </span>
                    </li>

                    <li class="list-group-item d-flex justify-content-between">
                        الحمل
                        <span class="badge @(Model.HealthCondition.IsPregnant ? "bg-danger" : "bg-success")">
                            @(Model.HealthCondition.IsPregnant ? "✔ Yes" : "✖ No")
                        </span>
                    </li>

                    <li class="list-group-item d-flex justify-content-between">
                        أمراض جلدية
                        <span class="badge @(Model.HealthCondition.HasSkinDisease ? "bg-danger" : "bg-success")">
                            @(Model.HealthCondition.HasSkinDisease ? "✔ Yes" : "✖ No")
                        </span>
                    </li>

                    <li class="list-group-item d-flex justify-content-between">
                        مشاكل ضغط الدم
                        <span class="badge @(Model.HealthCondition.HasBloodPressureIssue ? "bg-danger" : "bg-success")">
                            @(Model.HealthCondition.HasBloodPressureIssue ? "✔ Yes" : "✖ No")
                        </span>
                    </li>

                    <li class="list-group-item d-flex justify-content-between">
                        عملية جراحية حديثة
                        <span class="badge @(Model.HealthCondition.HasRecentSurgery ? "bg-danger" : "bg-success")">
                            @(Model.HealthCondition.HasRecentSurgery ? "✔ Yes" : "✖ No")
                        </span>
                    </li>

                </ul>

            </div>
        </div>

    </div>

</div>

<br>

<a asp-action="Index" class="btn btn-secondary">
    رجوع
</a>