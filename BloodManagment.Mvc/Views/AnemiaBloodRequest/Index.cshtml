@using BloodManagment.Mvc.ViewModels.AnemiaBloodRequest

@using BloodManagment.domain.Entities
@model List<AnemiaBloodRequestVm>

@{
    ViewData["Title"] = "طلبات مرضى الانميا";
    Layout = "_DashboardLayout";
}

<div class="table-card" dir="rtl">

    <table class="table table-hover text-center align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>الكود</th>
                <th>الجهة</th>
                <th>الحالة</th>
                <th>الفصيلة</th>
                <th>الهيموجلوبين</th>
                <th>تاريخ الحضور</th>
                <th>الإجراءات</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                var statusClass = item.Status.ToString().Replace(" ", "");

                <tr>
                    <td>
                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="fw-bold text-decoration-none">
                            @item.RequestCode
                        </a>
                    </td>
                    <td>@item.RequestCode</td>
                    <td>@item.ResponsibleEntity</td>

                    <!-- 🟡 Status -->
                    <td>
                        <span class="status-badge @statusClass">
                            @item.Status
                        </span>
                    </td>

                    <td class="blood">@item.BloodGroup</td>

                    <!-- 🧪 Hemoglobin -->
                    <td>
                        <span class="@(item.HemoglobinLevel < 8 ? "low-hb" : "")">
                            @item.HemoglobinLevel
                        </span>
                    </td>

                    <td>@item.AttendanceDate.ToString("yyyy-MM-dd")</td>

                    <!-- ⚙️ ACTIONS -->
                    <td>
                        <div class="actions">

                            @if (item.Status == RequestStatus.Pending)
                            {
                                <!-- ✔ Accept -->
                                <form asp-action="Approve" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-success btn-sm">
                                        <i class="fa-solid fa-check"></i>
                                        قبول
                                    </button>
                                </form>

                                <!-- ✖ Reject -->
                                <form asp-action="Reject" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-danger btn-sm">
                                        <i class="fa-solid fa-xmark"></i>
                                        رفض
                                    </button>
                                </form>
                            }

                            else if (item.Status == RequestStatus.Approved)
                            {
                                <!-- ➕ Assign -->
                                <a asp-action="Assign"
                                   asp-route-requestId="@item.Id"
                                   class="btn btn-primary btn-sm">
                                    <i class="fa-solid fa-user-plus"></i>
                                    تعيين
                                </a>
                            }

                            else
                            {
                                <span class="text-muted">—</span>
                            }

                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<style>
    /* 📦 Container */
    .table-card {
        background: #f3f0ea;
        border-radius: 20px;
        padding: 25px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
    }

    /* 📋 Table */
    .table th {
        font-size: 13px;
        color: #777;
        font-weight: 600;
    }

    .table td {
        font-size: 14px;
    }

    /* 🟡 Status */
    .status-badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: bold;
    }

        /* 🎨 Status Colors */
        .status-badge.Pending {
            background: #fff3cd;
            color: #856404;
        }

        .status-badge.Approved {
            background: #d4edda;
            color: #155724;
        }

        .status-badge.Accepted {
            background: #cce5ff;
            color: #004085;
        }

        .status-badge.Rejected {
            background: #f8d7da;
            color: #721c24;
        }

        .status-badge.Cancelled {
            background: #343a40;
            color: white;
        }

    /* 🩸 Blood */
    .blood {
        font-weight: bold;
        color: #e53935;
    }

    /* 🧪 Hemoglobin */
    .low-hb {
        background: #ffe5e5;
        padding: 4px 8px;
        border-radius: 8px;
        color: red;
        font-weight: bold;
    }

    /* ⚙️ Actions */
    .actions {
        display: flex;
        justify-content: center;
        gap: 5px;
        flex-wrap: wrap;
    }

    /* 🔘 Buttons */
    .btn {
        border-radius: 8px;
        padding: 4px 10px;
        font-size: 13px;
    }

    /* 📱 Responsive Fix */
   @*  @media (max-width: 768px) {
        .actions

    {
        flex-direction: column;
    }

    } *@
</style>