@using BloodManagment.Mvc.ViewModels.AnemiaBloodRequest
@model List<AnemiaBloodRequestVm>
@{
    ViewData["Title"] = "طلبات مرضى الانميا";
    Layout = "_DashboardLayout";
}
<div class="table-card">
    <table class="table text-center align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>الكود</th>
                <th>الجهة</th>
                <th>الحالة</th>
                <th>الفصيلة</th>
                <th>الهيموجلوبين</th>
                <th>تاريخ الحضور</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.RequestCode</td>
                    <td>@item.ResponsibleEntity</td>

                    <td>
                        <span class="status-badge @(item.Status.ToString())">
                            @item.Status
                        </span>
                    </td>

                    <td>@item.BloodGroup</td>

                    <td>
                        <span class="@(item.HemoglobinLevel < 8 ? "text-danger fw-bold" : "")">
                            @item.HemoglobinLevel
                        </span>
                    </td>

                    <td>@item.AttendanceDate.ToString("yyyy-MM-dd")</td>

                    <td class="actions">
                        <button class="btn btn-sm btn-outline-danger">🗑</button>
                        <a asp-controller="AnemiaBloodRequest"
                           asp-action="Assign"
                           asp-route-requestId="@item.Id"
                           class="btn btn-sm btn-outline-primary">
                            تعيين
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<style>
    /* 🌍 Page */
    .anemia-page {
        direction: rtl;
        font-family: 'Cairo', sans-serif;
    }

    /* 📦 Table Container */
    .table-card {
        background: linear-gradient(145deg, #f3f0ea, #ffffff);
        border-radius: 20px;
        padding: 25px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
    }

    /* 📋 Table */
    .table {
        margin-bottom: 0;
    }

        .table thead th {
            font-size: 13px;
            color: #888;
            font-weight: 600;
            border-bottom: 2px solid #eee;
            padding: 15px 10px;
        }

        /* 🧾 Rows */
        .table tbody tr {
            transition: all 0.25s ease;
            border-radius: 12px;
        }

            .table tbody tr:hover {
                background: #fff5f5;
                transform: scale(1.01);
                box-shadow: 0 4px 10px rgba(0,0,0,0.05);
            }

        /* 📌 Cells */
        .table td {
            font-size: 14px;
            padding: 14px 10px;
            vertical-align: middle;
        }

    /* 🟡 Status Badge */
    .status-badge {
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
    }

        .status-badge.Pending {
            background: #fff3cd;
            color: #856404;
        }

        .status-badge.Completed {
            background: #d4edda;
            color: #155724;
        }

    /* 🩸 Blood Group */
    td:nth-child(5) {
        font-weight: bold;
        color: #e53935;
    }

    /* 🧪 Hemoglobin */
    .text-danger.fw-bold {
        background: #ffe5e5;
        padding: 4px 10px;
        border-radius: 10px;
    }

    /* ⚙️ Actions */
    .actions {
        display: flex;
        justify-content: center;
        gap: 6px;
    }

        /* 🔘 Buttons */
        .actions .btn {
            border-radius: 10px;
            padding: 4px 10px;
            transition: 0.2s;
        }

        /* 🗑 Delete */
        .actions .btn-outline-danger:hover {
            background: #e53935;
            color: #fff;
            transform: scale(1.1);
        }

        /* ➕ Assign */
        .actions .btn-outline-primary:hover {
            background: #1976d2;
            color: #fff;
            transform: scale(1.1);
        }

    /* ✨ Smooth */
    * {
        transition: all 0.2s ease-in-out;
    }</style>
