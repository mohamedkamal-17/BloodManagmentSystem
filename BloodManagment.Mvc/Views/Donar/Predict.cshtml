@using BloodManagment.Application.features.DonationPredictionService
@model PredictionResultVm

@{
    ViewData["Title"] = "نتيجة التوقع";
    Layout = "_DashboardLayout";
}

<style>
    /* 🌑 Full Overlay Background */
    .prediction-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.55);
        backdrop-filter: blur(4px);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
        animation: fadeIn 0.4s ease;
    }

    /* 🪟 Card */
    .prediction-card {
        background: #f3f0ea;
        padding: 40px;
        border-radius: 24px;
        width: 420px;
        text-align: center;
        box-shadow: 0 25px 60px rgba(0,0,0,0.25);
        animation: slideUp 0.4s ease;
        position: relative;
    }

    /* ❌ Close Button */
    .close-btn {
        position: absolute;
        top: 12px;
        left: 15px;
        font-size: 20px;
        cursor: pointer;
        color: #888;
    }

        .close-btn:hover {
            color: #e53935;
        }

    /* 📊 Circle */
    .probability-circle {
        width: 130px;
        height: 130px;
        border-radius: 50%;
        background: conic-gradient(#28a745 @(Model.Probability * 360) deg, #ddd 0deg);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: auto;
        position: relative;
    }

        .probability-circle span {
            background: white;
            width: 100px;
            height: 100px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            font-weight: bold;
        }

    /* 🧠 Status */
    .status-box {
        padding: 12px;
        border-radius: 14px;
        font-weight: bold;
        margin-top: 15px;
    }

        .status-box.good {
            background: #d4edda;
            color: #155724;
        }

        .status-box.bad {
            background: #f8d7da;
            color: #721c24;
        }

    /* ⭐ Stars */
  /*   .stars span {
        font-size: 22px;
        transition: transform 0.2s;
    } */

        .stars span:hover {
            transform: scale(1.3);
        }

    /* 🏆 Level */
    .level {
        font-weight: bold;
        color: #e53935;
        font-size: 18px;
    }
    /* 🎯 Wrapper */
    .rating-wrapper {
        display: flex;
        justify-content: center;
        margin-top: 15px;
    }

    /* 🔵 Circle with dynamic progress */
    .rating-circle {
        width: 140px;
        height: 140px;
        border-radius: 50%;
        background: conic-gradient( #ffc107 @(Model.Stars * 72)deg, #e0e0e0 0deg );
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
    }

        /* Inner white circle */
        .rating-circle::before {
            content: "";
            position: absolute;
            width: 110px;
            height: 110px;
            background: #fff;
            border-radius: 50%;
        }

    /* ⭐ Stars container */
    .stars {
        position: relative;
        z-index: 2;
    }

        /* ⭐ Filled star */
        .stars .filled {
            color: #ffc107;
            font-size: 20px;
        }

        /* ☆ Empty star */
        .stars .empty {
            color: #ccc;
            font-size: 20px;
        }

    /* 🎬 Animations */
    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    @@keyframes slideUp {
        from {
            transform: translateY(40px);
            opacity: 0;
        }

        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

</style>

<div class="prediction-overlay">

    <div class="prediction-card">

        <!-- ❌ Close -->
        <a asp-action="Index" class="close-btn">✖</a>

        <!-- 🎯 Header -->
        <h3 class="mb-3">🔮 تحليل المتبرع</h3>

        <!-- 📊 Circle -->
        <div class="probability-circle">
            <span>@Math.Round(Model.Probability * 100)%</span>
        </div>

        <p class="mt-2 text-muted">
            احتمالية التبرع
        </p>

        <!-- 🧠 Status -->
        <div class="status-box @(Model.WillDonate ? "good" : "bad")">
            @(Model.WillDonate ? "✅ متوقع التبرع" : "⚠️ يحتاج متابعة")
        </div>

        <!-- ⭐ Gamification -->
        <div class="rating-wrapper">

            <!-- 🔵 Circle -->
            <div class="rating-circle">

                <!-- ⭐ Stars -->
                <div class="stars">
                    @for (int i = 1; i <= 5; i++)
                    {
                        if (i <= Model.Stars)
                        {
                            <span class="filled">★</span>
                        }
                        else
                        {
                            <span class="empty">☆</span>
                        }
                    }
                </div>

            </div>

        </div>

        <!-- 💬 Message -->
        <div class="alert alert-info mt-3">
            @Model.Message
        </div>

        <!-- 🔘 Actions -->
        <div class="mt-4 d-flex justify-content-center gap-3">

            <a asp-action="Index" class="btn btn-secondary">
                رجوع
            </a>

            <a asp-controller="Donar"
               asp-action="Predict"
               asp-route-id="@Context.Request.RouteValues["id"]"
               class="btn btn-success">
                إعادة التوقع 🔁
            </a>

        </div>

    </div>

</div>