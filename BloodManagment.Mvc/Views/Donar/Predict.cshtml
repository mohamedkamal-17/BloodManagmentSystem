@using BloodManagment.Application.features.DonationPredictionService
@model PredictionResultVm

@{
    ViewData["Title"] = "نتيجة التوقع";
    Layout = "_DashboardLayout";
}
<style>
    /* 🌑 Overlay */
    .prediction-overlay {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 80vh;
    }

    /* 🪟 Card */
    .prediction-card {
        background: #f3f0ea;
        padding: 40px;
        border-radius: 20px;
        width: 420px;
        text-align: center;
        box-shadow: 0 15px 40px rgba(0,0,0,0.1);
    }

    /* 📊 Circle */
    .probability-circle {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background: linear-gradient(135deg, #28a745, #4caf50);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        font-weight: bold;
        margin: auto;
    }

    /* 🧠 Status */
    .status-box {
        padding: 10px;
        border-radius: 12px;
        font-weight: bold;
    }

        .status-box.good {
            background: #d4edda;
            color: #155724;
        }

        .status-box.bad {
            background: #f8d7da;
            color: #721c24;
        }

    /* ⭐ Stars */
    .stars span {
        font-size: 20px;
    }

    /* 🏆 Level */
    .level {
        font-weight: bold;
        color: #e53935;
    }</style>

<div class="prediction-overlay">

    <div class="prediction-card">

        <!-- 🎯 Header -->
        <h3 class="mb-3">🔮 تحليل المتبرع</h3>

        <!-- 📊 Probability -->
        <div class="probability-circle">
            @Math.Round(Model.Probability * 100)%
        </div>

        <p class="mt-2 text-muted">
            احتمالية التبرع
        </p>

        <!-- 🧠 Status -->
        <div class="status-box @(Model.WillDonate ? "good" : "bad")">
            @(Model.WillDonate ? "✅ متوقع التبرع" : "⚠️ يحتاج متابعة")
        </div>

        <!-- ⭐ Gamification -->
        <div class="mt-3">
            <h5>التقييم</h5>

            <div class="stars">
                @for (int i = 0; i < Model.Stars; i++)
                {
                    <span>⭐</span>
                }
            </div>

            <div class="level mt-2">
                @Model.Level
            </div>
        </div>

        <!-- 💬 Message -->
        <div class="alert alert-info mt-3">
            @Model.Message
        </div>

        <!-- 🔘 Actions -->
        <div class="mt-4 d-flex justify-content-center gap-3">

            <a asp-action="Index" class="btn btn-secondary">
                رجوع
            </a>

            <a asp-controller="Donar"
               asp-action="Predict"
               asp-route-id="@Context.Request.RouteValues["id"]"
               class="btn btn-success">
                إعادة التوقع 🔁
            </a>

        </div>

    </div>

</div>