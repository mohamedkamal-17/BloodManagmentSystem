@using BloodManagment.Application.features.BloodRequestfeat.Queries
@model BloodRequestDto

<div class="col-md-4">

    <div class="card p-3 shadow-sm border-0 rounded-4 blood-request-card">

        <div class="d-flex justify-content-between align-items-center header-section">

            <div>

                <h5 class="fw-bold patient-name">@Model.PatientName</h5>

                <small class="text-muted profile-link">
                    عرض البروفيل
                </small>

            </div>

            <img src="/images/user.png"
                 class="rounded-circle user-avatar"
                 width="40"
                 height="40" />

        </div>

        <div class="mt-3 details-section">

            <p class="info-row">
                <b>الفصيلة:</b> <span class="value">@Model.BloodGroup</span>
            </p>

            <p class="info-row">
                <b>الحالة:</b> <span class="value">@Model.Reason</span>
            </p>

            <p class="info-row">
                <b>الموعد:</b> <span class="value">@Model.RequestDate.ToShortDateString()</span>
            </p>

        </div>

        <div class="d-flex justify-content-between mt-3 actions-section">
            <a asp-action="Details"
               asp-route-id="@Model.Id"
               class="btn btn-outline-primary action-btn view-btn"
               data-bs-toggle="modal"
               data-bs-target="#detailsModal">
                عرض
            </a>

            <form asp-action="Accept" method="post">

                <input type="hidden" name="id" value="@Model.Id" />

                <button type="submit" class="btn btn-success action-btn accept-btn">
                    قبول
                </button>

            </form>

            <form asp-action="Delete" method="post">

                <input type="hidden" name="id" value="@Model.Id" />

                <button type="submit" class="btn btn-outline-danger action-btn delete-btn">
                   
                </button>

            </form>

        </div>

    </div>

</div>

<style>
    .blood-request-card {
        background: linear-gradient(145deg, #ebe5db, #e3ddd2);
        border-radius: 28px;
        padding: 22px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08), inset 0 1px 0 rgba(255,255,255,0.4);
        transition: all 0.35s ease;
        position: relative;
        overflow: hidden;
    }

        /* Soft hover lift */
        .blood-request-card:hover {
            transform: translateY(-6px) scale(1.01);
            box-shadow: 0 20px 40px rgba(0,0,0,0.12), inset 0 1px 0 rgba(255,255,255,0.5);
        }

        /* subtle light sweep */
        .blood-request-card::after {
            content: "";
            position: absolute;
            top: 0;
            left: -120%;
            width: 100%;
            height: 100%;
            background: linear-gradient(120deg, transparent, rgba(255,255,255,0.25), transparent);
            transition: 0.6s;
        }

        .blood-request-card:hover::after {
            left: 120%;
        }

    /* Header */
    .patient-name {
        font-size: 20px;
        font-weight: 800;
        color: #2f2f2f;
    }

    .profile-link {
        color: #dc3545 !important;
        font-size: 13px;
        position: relative;
    }

        .profile-link::after {
            content: "";
            position: absolute;
            bottom: -2px;
            right: 0;
            width: 0%;
            height: 2px;
            background: #dc3545;
            transition: 0.3s;
        }

        .profile-link:hover::after {
            width: 100%;
        }

    /* Avatar */
    .user-avatar {
        border: 2px solid #dc3545;
        padding: 2px;
        transition: 0.3s;
    }

        .user-avatar:hover {
            transform: scale(1.08);
        }

    /* Details */
    .details-section {
        margin-top: 15px;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
        font-size: 15px;
    }

        .info-row b {
            color: #3a3a3a;
        }

    .value {
        color: #6b6b6b;
        font-weight: 500;
    }

    /* Actions */
    .actions-section {
        margin-top: 22px;
        gap: 10px;
    }

    /* Base button */
    .action-btn {
        flex: 1;
        border-radius: 25px;
        padding: 9px 0;
        font-weight: 600;
        position: relative;
        overflow: hidden;
        transition: all 0.25s ease;
    }

        /* Ripple illusion */
        .action-btn::after {
            content: "";
            position: absolute;
            width: 0;
            height: 0;
            background: rgba(255,255,255,0.3);
            border-radius: 50%;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            transition: width 0.4s, height 0.4s;
        }

        .action-btn:active::after {
            width: 200px;
            height: 200px;
        }

    /* View */
    .view-btn {
        border: 1.5px solid #0d6efd;
        color: #0d6efd;
        background: transparent;
    }

        .view-btn:hover {
            background: #0d6efd;
            color: white;
            box-shadow: 0 0 10px rgba(13,110,253,0.4);
        }

    /* Accept */
    .accept-btn {
        border: 1.5px solid #198754;
        color: #198754;
        background: transparent;
    }

        .accept-btn:hover {
            background: #198754;
            color: white;
            box-shadow: 0 0 12px rgba(25,135,84,0.4);
        }

    /* Delete (icon circle) */
    .delete-btn {
        border: 1.5px solid #dc3545;
        color: #dc3545;
        background: transparent;
        width: 46px;
        height: 46px;
        border-radius: 50% !important;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
    }

        /* Clean SVG trash icon */
        .delete-btn::before {
            content: "";
            width: 18px;
            height: 18px;
            background: url("data:image/svg+xml;utf8,\
    <svg fill='none' stroke='%23dc3545' stroke-width='2' viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'>\
    <path stroke-linecap='round' stroke-linejoin='round' d='M6 7h12M9 7V4h6v3m-9 0l1 13h8l1-13'></path>\
    </svg>") no-repeat center;
        }

        .delete-btn:hover {
            background: #dc3545;
        }

            .delete-btn:hover::before {
                filter: brightness(0) invert(1);
            }

    /* Micro spacing harmony */
    .header-section {
        margin-bottom: 5px;
    }
</style>